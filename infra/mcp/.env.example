# uapm-mcp local development env
UAPM_BACKEND_MODE=mock
# UAPM_BACKEND_BASE_URL=http://host.docker.internal:8080
# UAPM_BACKEND_SERVICE_TOKEN=change-me-in-your-local-vault
UAPM_MCP_SERVICE_TOKEN=change-me-dev-only
LOG_LEVEL=info
UAPM_REQUEST_TIMEOUT_MS=10000
UAPM_MAX_RETRIES=2
UAPM_MAX_PAGE_SIZE=100

# n8n local dev
N8N_ENCRYPTION_KEY=change-me-n8n-key-32-chars-min__
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_PORT=5678

# Model (configurable, not committed)
# OPENAI_API_KEY=sk-...
UAPM_MODEL=gpt-4.1-mini
