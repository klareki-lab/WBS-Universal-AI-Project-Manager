{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "goals": {
      "default": "",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "requirements": {
      "default": "",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "start_date": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_date": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
