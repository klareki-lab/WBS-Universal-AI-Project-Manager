    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
        },
        "message": {
          "type": "string",
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
        }
      },
      "required": [
