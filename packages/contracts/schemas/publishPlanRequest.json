{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "content_hash": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
        },
        {
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    }
  },
  "required": [
    "content_hash"
  ],
  "additionalProperties": false
}
