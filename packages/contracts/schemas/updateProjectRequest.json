{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "on_hold",
        "completed",
        "archived"
      ]
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
