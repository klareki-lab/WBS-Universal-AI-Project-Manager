        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.MCP_UAPM_SERVICE_TOKEN }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $('Resolve read intent').item.json.request.principal.correlationId }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\n  \"tool\": \"get_project_progress\",\n  \"arguments\": { \"projectId\": \"{{ $('Resolve read intent').item.json.projectId }}\" }\n}",
        "options": {
          "timeout": 10000,
