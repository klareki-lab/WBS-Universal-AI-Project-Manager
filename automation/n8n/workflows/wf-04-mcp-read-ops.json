        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json; const d = r.decision || {}; const req = r.request;\n// Normalize read intent: project overview or task list\nconst projectId = d.projectId || req.projectId || null;\nif (!projectId) return [{ json: { error: 'projectId_missing' } }];\nreturn [{ json: { request: req, projectId, kind: d.readKind || 'overview' } }];"
      },
      "id": "resolve-read",
      "name": "Resolve read intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MCP_UAPM_URL }}/invoke/get_project",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.MCP_UAPM_SERVICE_TOKEN }}"
            },
            {
              "name": "x-on-behalf-of",
              "value": "={{ $json.request.principal.userId }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.request.principal.correlationId }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\n  \"arguments\": { \"id\": \"{{ $json.projectId }}\" }\n}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "get-project",
