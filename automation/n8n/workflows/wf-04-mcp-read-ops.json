        120,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MCP_UAPM_URL }}/invoke/list_project_tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.MCP_UAPM_SERVICE_TOKEN }}"
            },
            {
              "name": "x-on-behalf-of",
              "value": "={{ $('Resolve read intent').item.json.request.principal.userId }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $('Resolve read intent').item.json.request.principal.correlationId }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\n  \"arguments\": { \"projectId\": \"{{ $('Resolve read intent').item.json.projectId }}\", \"limit\": 50 }\n}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "list-tasks",
      "name": "List tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const project = $('Get project').item.json;\nconst progress = $('Get progress').item.json;\nconst tasks = $('List tasks').item.json;\nconst req = $('Resolve read intent').item.json.request;\nconst err = project.error || progress.error || tasks.error;\nif (err) return [{ json: { response: `Read failed: ${err.message || err.code}`, correlationId: req.principal.correlationId, operationIds: [] } }];\nconst totalTasks = progress.counts?.total ?? 0;\nconst completion = Math.round((progress.completionRatio ?? 0) * 100);\nconst head = tasks.items?.slice(0, 5).map(t => `- ${t.title} [${t.status}]`).join('\\n') || 'no tasks';\nreturn [{ json: {\n  response: `Project ${project.name}: ${totalTasks} tasks, ${completion}% done. Overdue: ${progress.overdue}.\\nFirst tasks:\\n${head}`,\n  correlationId: req.principal.correlationId,\n  operationIds: []\n} }];"
      },
      "id": "shape-read",
      "name": "Shape read response",
      "type": "n8n-nodes-base.code",
