    {
      "parameters": {
        "jsCode": "const d = $json.decision; return [{ json: { response: `Clarification needed: ${d.question || d.rationale}`, correlationId: $('Prepare request').item.json.request.principal.correlationId, operationIds: [] } }];"
      },
      "id": "clarify",
      "name": "Clarify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        680
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { response: r.response || r.summary || 'Done.', correlationId: r.correlationId || $('Prepare request').item.json.request.principal.correlationId, operationIds: r.operationIds || [] } }];"
      },
      "id": "shape-core-output",
      "name": "Shape core output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;\nif(raw.headers){if(raw.headers.authorization!=='Bearer '+$env.UAPM_WEBHOOK_TOKEN)throw new Error('Unauthorized G3 webhook');return [{json:raw.body}];}\nreturn [{json:raw}];"
      },
      "id": "entry-packet",
      "name": "Entry packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;return [{json:{output:JSON.stringify({intent:r.request.intent||'plan',projectId:r.request.projectId,rationale:'Synthetic deterministic G3 orchestration fixture'})}}];"
      },
      "id": "fixture-coordinator",
      "name": "Fixture Coordinator",
      "type": "n8n-nodes-base.code",
