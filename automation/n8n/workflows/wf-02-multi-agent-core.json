        "httpHeaderAuth": {
          "id": "G3WebhookAuth001",
          "name": "G3 isolated webhook bearer"
        }
      }
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "subworkflow-input",
      "name": "Sub-workflow input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -640,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;if(!r.request?.projectId||!r.request?.principal?.correlationId)throw new Error('Missing project or request identity');return [{json:r}];"
      },
      "id": "prepare-request",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        390
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the Coordinator agent for the Universal AI Project Manager.\nUser request: {{ $json.request.text }}\nSession: {{ $json.request.sessionId }}\n\nDecide the intent and respond strictly as JSON with keys:\n  intent: one of 'plan', 'review', 'status', 'change', 'clarify'\n  projectId: string | null (if the user named one)\n  rationale: short string\n  question: string | null (only when intent='clarify')\n\nRules:\n- Do NOT invent project data.\n- Do NOT claim human approval was granted.\n- If intent is unclear or project is missing, choose 'clarify'.\n- Return JSON only, no prose.",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "Return pure JSON. Max iterations 3.",
          "maxIterations": 3
        }
      },
      "id": "coordinator-agent",
      "name": "Coordinator agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        20,
        390
      ]
    },
    {
      "parameters": {
        "model": "={{ $env.UAPM_MODEL || 'gpt-4.1-mini' }}",
        "options": {
          "temperature": 0.2,
          "maxTokens": 1200
        }
      },
      "id": "coordinator-llm",
      "name": "Coordinator model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        20,
        580
      ],
      "credentials": {
        "openAiApi": {
          "id": "uapm-openai",
          "name": "UAPM OpenAI (dev)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const decision=typeof $json.output==='string'?JSON.parse($json.output):$json.output;const packet=$('Prepare request').first().json;if(decision.projectId!==packet.request.projectId)throw new Error('Coordinator cannot change project scope');return [{json:{...packet,decision}}];"
      },
      "id": "parse-decision",
      "name": "Parse decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        390
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision.intent }}",
                    "rightValue": "plan",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision.intent }}",
                    "rightValue": "status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision.intent }}",
                    "rightValue": "change",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route-intent",
      "name": "Route intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        500,
        390
      ],
      "parameters.rules.values": []
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": "G3Workflow0000003",
        "options": {
          "waitForSubWorkflow": true
        }
      },
