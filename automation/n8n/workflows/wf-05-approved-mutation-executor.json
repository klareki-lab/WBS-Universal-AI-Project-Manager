{
  "name": "UAPM WF-05 — Approved Mutation Executor",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "sub-input",
      "name": "Sub-workflow input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -720,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate the structured mutation request. No LLM is allowed to synthesize this freely.\nconst r = $input.first().json;\nconst req = r.request || {};\nconst d = r.decision || {};\nconst op = r.operation || d.operation || {};\nconst allowed = new Set(['publish_approved_plan','update_task_status','update_task']);\nif (!allowed.has(op.name)) (()=>{throw new Error('Invalid operation')})();\nif (!op.arguments || typeof op.arguments !== 'object') (()=>{throw new Error('Missing arguments')})();\nif (!op.arguments.idempotencyKey) (()=>{throw new Error('Missing idempotency key')})();\n// For publish_approved_plan, we MUST verify approval status first.\nreturn [{ json: { request: req, op } }];"
      },
      "id": "validate-op",
      "name": "Validate mutation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.op.name }}",
              "rightValue": "publish_approved_plan",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "needs-approval-check",
      "name": "Needs approval check?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MCP_UAPM_URL }}/call-tool",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.MCP_UAPM_SERVICE_TOKEN }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.request.principal.correlationId }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={{ JSON.stringify({tool:'get_approval_status',arguments:{projectId:$json.op.arguments.projectId,planVersionId:$json.op.arguments.planVersionId} }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "specifyBody": "json"
      },
      "id": "fetch-approval",
      "name": "Fetch approval status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "if($json.state!=='approved')throw new Error('Human approval required');return [{json:$('Validate mutation').first().json}];"
      },
      "id": "enforce-approval",
      "name": "Enforce human approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MCP_UAPM_URL }}/call-tool",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{ $env.MCP_UAPM_SERVICE_TOKEN }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.request.principal.correlationId }}"
            }
          ]
        },
        "sendBody": true,
        "jsonBody": "={\n  \"tool\": \"{{ $json.op.name }}\",\n  \"arguments\": {{ JSON.stringify($json.op.arguments) }}\n}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 2
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "specifyBody": "json"
      },
      "id": "exec-mutation",
      "name": "Execute mutation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $json;\nconst req = $('Validate mutation').item.json.request;\nif (res.error) return [{ json: { response: `Mutation failed: ${res.error.code}: ${res.error.message}`, correlationId: req.principal.correlationId, operationIds: [] } }];\nreturn [{ json: { response: `Mutation succeeded (operationId=${res.operationId})`, correlationId: req.principal.correlationId, operationIds: [res.operationId] } }];"
      },
      "id": "shape-exec",
      "name": "Shape execution result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "g3/wf-05",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "g3-webhook-5",
      "name": "G3 service webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        600
      ],
      "webhookId": "g3-wf-05",
      "credentials": {
        "httpHeaderAuth": {
          "id": "G3WebhookAuth001",
          "name": "G3 isolated webhook bearer"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;\nif(raw.headers){if(raw.headers.authorization!=='Bearer '+$env.UAPM_WEBHOOK_TOKEN)throw new Error('Unauthorized G3 webhook');return [{json:raw.body}];}\nreturn [{json:raw}];"
      },
      "id": "entry-packet",
      "name": "Entry packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        600
      ]
    }
  ],
