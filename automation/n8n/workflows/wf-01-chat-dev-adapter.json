        "jsCode": "const input=$input.first().json;\nif(input.operation_id){\n if(!input.project_id||!input.request_id||!input.context_hash||!input.input?.base_project_version)throw new Error('Missing durable provenance');\n return [{json:{request:{text:input.input.prompt,projectId:input.project_id,sessionId:input.conversation_session_id,principal:{correlationId:input.request_id},channel:'backend-worker'},operation:input}}];\n}\nif(!input.request?.projectId)throw new Error('projectId required');\nreturn [{json:input}];"
