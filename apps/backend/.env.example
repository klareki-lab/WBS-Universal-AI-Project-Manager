DATABASE_URL=postgresql://uapm:replace-with-random-local-secret@127.0.0.1:15439/uapm
HOST=127.0.0.1
PORT=13081
ALLOWED_ORIGIN=http://localhost:5173
# Browser API URL: http://localhost:13081 (same hostname as frontend).
COOKIE_SECURE=false
# Never use DATABASE_URL for tests: tests require a separately named database ending _test.
TEST_DATABASE_URL=postgresql://uapm:replace-with-random-local-secret@127.0.0.1:15439/uapm_test
# Internal fixed adapter URL. Optional until automation is available.
N8N_ENDPOINT=
N8N_TOKEN=
# Administrative CLI only; not consumed by the HTTP server.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SERVICE_NAME=
SERVICE_PROJECT_ID=
SERVICE_SCOPES=read,plans:write,operations:write

# Optional trusted automation identity, assigned atomically to newly created projects.
# Provision this service before enabling; unset preserves explicit manual membership.
# AUTOMATION_SERVICE_ID=00000000-0000-4000-8000-000000000000
